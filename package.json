{
  "name": "plugit",
  "private": true,
  "version": "1.0.0",
  "description": "Diseñador y Generador de Trayectorias de Puntada (PlugiT)",
  "author": "PlugiT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs = require('fs'); if (!fs.existsSync('release')) fs.mkdirSync('release'); fs.copyFileSync('dist/index.html', 'release/PlugiT.html');\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http-get://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:32": "npm run build && electron-builder --win --ia32",
    "electron:build:all": "npm run build && electron-builder --win --x64 --ia32",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.plugit.cad",
    "productName": "PlugiT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PlugiT",
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} ${arch}.${ext}"
    }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "43.7.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.1.0"
  }
}
